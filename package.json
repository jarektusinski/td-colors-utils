{
  "name": "td-colors-utils",
  "version": "1.0.1",
  "description": "A lightweight TypeScript color utility library for validating, converting and mapping named colors, hex, RGB and RGBA values.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [
    "colors",
    "color-utils",
    "typescript",
    "color-conversion",
    "color-validation",
    "hex-to-rgb",
    "rgb-to-hex",
    "css-colors",
    "named-colors",
    "theme-utils"
  ],
  "author": "Jarosław Tusiński",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "td-colors-names": "^1.0.0"
  }
}
